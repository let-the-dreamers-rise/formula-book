{
  "name": "formula-book",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "dev:all": "node scripts/dev-all.mjs",
    "e2e": "playwright test",
    "e2e:m1": "playwright test golden-path-m1 needs-choice"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.15.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
